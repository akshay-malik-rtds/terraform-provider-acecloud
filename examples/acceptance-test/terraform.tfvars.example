# ─── Ace Cloud Provider Configuration ─────────────────────────
#
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# The provider supports 3 authentication methods (tried in order):
#   1. Static token (api_token)
#   2. Email/password login
#   3. ace-cli config fallback (~/.ace/config.json)
#
# ─── Method 1: Static Token (recommended for CI/CD) ──────────
#
# api_url   = "http://localhost:3000"
# api_token = "your-jwt-or-developer-token"
# region    = "mumbai"
# project_id = "your-openstack-project-uuid"
#
# ─── Method 2: Email/Password Login ──────────────────────────
# (Not supported for 2FA-enabled accounts)
#
# api_url  = "http://localhost:3000"
# email    = "your-email@example.com"
# password = "your-password"
# region   = "mumbai"           # optional: auto-selected from account
# project_id = "your-project"   # optional: auto-selected from account
#
# ─── Method 3: ace-cli Config ────────────────────────────────
# Just run 'ace auth login' first, then use:
#
# api_url = "http://localhost:3000"
# (token, region, project_id read from ~/.ace/config.json)
#
# ─── Environment Variables ───────────────────────────────────
# All values can also be set via environment variables:
#   ACECLOUD_API_URL, ACECLOUD_API_TOKEN, ACECLOUD_REGION,
#   ACECLOUD_PROJECT_ID, ACECLOUD_EMAIL, ACECLOUD_PASSWORD
#
# ─── Fill in your values below ───────────────────────────────

api_url    = "http://localhost:3000"
api_token  = "your-jwt-token-here"
region     = "mumbai"
project_id = "your-openstack-project-uuid"
